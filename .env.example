# --- Database -------------------------------------------------------------
# Only the LangGraph checkpointer uses this now, so a clarification asked today
# can be answered tomorrow from a different process.
# Host port 5433 avoids clashing with any local Postgres on 5432.
DATABASE_URL=postgresql://procurement:procurement@localhost:5433/procurement_agent

# --- LLM providers --------------------------------------------------------
# Read by LLMRoute, not by this app. Leave a key blank to disable that provider;
# the routing ladder skips it rather than failing.
#
# You need none of them if Ollama is running locally: it is the one keyless
# endpoint and the ladder always keeps it as the last candidate.
GROQ_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Search providers -----------------------------------------------------
# Read by SearchRoute. With none of these it still works, degraded: DuckDuckGo
# searches, trafilatura and Jina extract, and arXiv/PubMed/Crossref/Wikipedia
# are keyless. Fine for development; not something to build on.
#
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EXA_API_KEY=

# Brave is opt-in only in SearchRoute: it is skipped by auto-discovery even when
# set, because it costs money. Setting this key alone does nothing - the
# provider must also be named explicitly in the client's provider list.
# BRAVE_API_KEY=

# Identifies this client to the scholarly APIs (Crossref, PubMed), which give
# politer rate limits to callers who do.
SEARCHROUTE_CONTACT=

# --- API ------------------------------------------------------------------
# Shared key required in the X-API-Key header.
API_KEY=dev-local-key

# Host port the containerised API is published on, bound to 127.0.0.1. Change
# it if 8000 is taken - a collision stops the whole stack with a daemon-level
# bind error rather than anything that explains itself.
API_PORT=8000

# Browser origins allowed to call the API, comma-separated. Never `*`: these
# endpoints take a credential header and GET /runs returns real companies'
# contact details. Defaults cover the usual frontend dev-server ports.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Budgets --------------------------------------------------------------
# Ceiling on what ONE run may spend, across every node that searches. Separate
# from SearchRoute's own monthly per-provider ledger: this is what stops a
# single wide fan-out consuming the month in one request.
#
# Keyless providers (arXiv, PubMed, Crossref, Wikipedia, DuckDuckGo) cost 0, so
# this is spent almost entirely on finding vendors.
SEARCH_CREDITS_PER_SESSION=25
RESULTS_PER_QUERY=5
# Max concurrent fan-out branches. Kept low: free-tier rate limits, not
# latency, are the binding constraint.
MAX_FANOUT=3

LOG_LEVEL=INFO

# --- Research literature search (arXiv/PubMed/Crossref: free, no key) ---
ENABLE_RESEARCH_SEARCH=true
RESEARCH_SEARCH_CREDITS=4

# --- Local crawling (crawl4ai: free, and the only path that renders JS) ---
ENABLE_CRAWL4AI=true
CRAWL_MAX_CONTACT_PAGES=3
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT=25
CRAWL_RESPECT_ROBOTS=true

# --- Observability --------------------------------------------------------
# Optional. Every run is traced into its runs/*.json file regardless; these only
# mirror that to Langfuse. Set both keys to enable it.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Cloud, or a self-hosted instance (http://localhost:3000). Self-hosting removes
# the 50k units/month cap but wants ~4 cores / 16 GiB for its six containers.
# LANGFUSE_HOST=https://cloud.langfuse.com

# Pin a run to whichever provider served its first LLM call. Off by default: on
# free tiers, spreading across providers as quota allows beats concentrating
# load on one provider's limit.
LLM_STICKY_SESSION=false

# --- Run archive ----------------------------------------------------------
# Every completed run is written here as one JSON file. A record, not a cache:
# the graph never reads it back, so a stored run cannot stand in for a fresh
# search. Retrieve with --list-runs / --show-run.
ENABLE_RUN_ARCHIVE=true

# Look the material up before asking clarifying questions, so the questions are
# not built on a misreading of a trade name. This is the one node a person waits
# on, so it is a single lookup and can be turned off.
ENABLE_SPEC_LOOKUP=true
